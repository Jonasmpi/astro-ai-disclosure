---
import AIImage from "@jonasmpi/astro-ai-disclosure/AIImage.astro";

import platedDish from "../../assets/plated-dish.jpg";
import ScenarioLayout from "../../layouts/ScenarioLayout.astro";

/**
 * Ordinary editing of a real photograph. Article 50 does not treat this as
 * disclosure-worthy, so `eu-article-50` stays silent — but the declaration is
 * still recorded in the markup.
 */
const ai = {
  kind: "assisted",
  scope: "not-in-scope",
  description: "Colour correction and background cleanup",
} as const;
---

<ScenarioLayout
  title="AI-assisted photograph"
  intro="A real photograph with ordinary AI-supported editing: kind=assisted, scope=not-in-scope."
  expectation="No badge under eu-article-50. A badge under all-ai, because that policy labels any declared AI involvement however minor. Both carry data-ai-kind=assisted regardless."
>
  <h2>Overridden to <code>eu-article-50</code> — no badge</h2>
  <p class="note">
    Routine retouching does not make a photograph appear inauthentic, so nothing is shown.
  </p>
  <AIImage
    src={platedDish}
    alt="A plated dish on a restaurant table"
    widths={[640, 960]}
    sizes="(max-width: 768px) 100vw, 640px"
    format="webp"
    policy="eu-article-50"
    ai={ai}
  />

  <h2>Site policy (<code>all-ai</code>) — badge shown</h2>
  <p class="note">
    The German label comes from the site's <code>defaultLanguage: "de"</code>, and reads
    <em>Mit KI-Unterstützung</em> — the built-in text that survived the label deep-merge.
  </p>
  <AIImage
    src={platedDish}
    alt="A plated dish on a restaurant table"
    widths={[640, 960]}
    sizes="(max-width: 768px) 100vw, 640px"
    format="webp"
    ai={ai}
  />

  <h2>No metadata at all — no badge, no attributes</h2>
  <p class="note">
    An <code>AIImage</code> without an <code>ai</code> prop renders a plain image. Step 2.2 turns this
    silence into a warning in dev and a build failure.
  </p>
  <AIImage
    src={platedDish}
    alt="A plated dish on a restaurant table"
    widths={[640]}
    sizes="640px"
    format="webp"
  />
</ScenarioLayout>

<style>
  h2 {
    margin-top: 2.25rem;
    font-size: 1.05rem;
  }

  .note {
    max-width: 46rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
