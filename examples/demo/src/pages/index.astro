---
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * Scenario pages arrive with the features they demonstrate. Each entry becomes
 * a real link in the step named in `step`; until then it renders as pending so
 * the index never points at a 404.
 */
const scenarios = [
  {
    href: "/config",
    title: "Central configuration",
    description: "The resolved integration options, read from virtual:astro-ai-disclosure/config.",
    step: "1.2",
    ready: true,
  },
  {
    href: "/scenarios/in-scope-generated",
    title: "In-scope generated image",
    description:
      "Photorealistic synthetic image declared as scope=deepfake — badge under both policies.",
    step: "1.3",
    ready: true,
  },
  {
    href: "/scenarios/voluntary-labelling",
    title: "Voluntary labelling",
    description:
      "Clearly fictional illustration, scope=not-in-scope — badge only under the all-ai policy.",
    step: "1.3",
    ready: true,
  },
  {
    href: "/scenarios/assisted-photo",
    title: "AI-assisted photograph",
    description: "Ordinary photo with kind=assisted — no badge under eu-article-50.",
    step: "1.3",
    ready: true,
  },
  {
    href: "/scenarios/picture",
    title: "AIPicture with art direction",
    description: "The same disclosure behaviour wrapped around <Picture> and its <source> set.",
    step: "1.4",
    ready: false,
  },
  {
    href: "/scenarios/sidecar-metadata",
    title: "Sidecar metadata",
    description: "Image labelled purely through a .ai.json sidecar, with no inline ai prop.",
    step: "2.1",
    ready: false,
  },
] as const;
---

<BaseLayout
  title="Demo site"
  intro="Example and integration-test site for the astro-ai-disclosure package. Every feature gets a scenario page here, and this site's build doubles as the package's integration test."
>
  <p class="status">
    The integration is registered in <code>astro.config.ts</code> with deliberately non-default options.
    It resolves and validates them, then exposes the result through
    <code>virtual:astro-ai-disclosure/config</code> — see the configuration page below. Components that
    consume it arrive in step 1.3.
  </p>

  <h2>Scenario pages</h2>
  <ul class="scenarios">
    {
      scenarios.map((scenario) => (
        <li>
          <div class="row">
            {scenario.ready ? (
              <a href={scenario.href}>{scenario.title}</a>
            ) : (
              <span class="pending">{scenario.title}</span>
            )}
            <span class="step">step {scenario.step}</span>
          </div>
          <p>{scenario.description}</p>
        </li>
      ))
    }
  </ul>

  <h2>House rule</h2>
  <p>
    This site must never import <code>Image</code> or <code>Picture</code> from
    <code>astro:assets</code> directly — that is exactly what the package forbids. Scenario pages use
    <code>AIImage</code> / <code>AIPicture</code> instead. From step 1.5 the build fails on a direct import.
  </p>

  <p class="assets">
    Sample images live in <code>src/assets/</code> — two Unsplash photographs and one generated gradient
    graphic. Credits and licence: <code>src/assets/CREDITS.md</code>.
  </p>

  <p class="assets warn">
    <strong>None of these images is AI-generated or AI-modified.</strong> The metadata the scenario pages
    attach to them — including <code>kind: "generated"</code> and <code>scope: "deepfake"</code> — is
    fictional, written only to exercise the disclosure logic under each policy. Declaring AI involvement
    that did not happen is as wrong as omitting it.
  </p>
</BaseLayout>

<style>
  .status,
  .assets {
    max-width: 46rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-size: 0.95rem;
  }

  .warn {
    border-left: 4px solid #d97706;
  }

  h2 {
    margin-top: 2.5rem;
    font-size: 1.15rem;
  }

  .scenarios {
    max-width: 46rem;
    padding: 0;
    list-style: none;
  }

  .scenarios li {
    padding: 0.9rem 0;
    border-top: 1px solid var(--border);
  }

  .scenarios p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .pending {
    font-weight: 600;
    color: var(--muted);
  }

  .row a {
    font-weight: 600;
    color: inherit;
  }

  .step {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  code {
    font-size: 0.88em;
  }
</style>
