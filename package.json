{
  "name": "astro-ai-disclosure-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for @jonasmpi/astro-ai-disclosure — AI disclosure labelling for Astro images",
  "license": "MIT",
  "author": "Jonas Szalanczi (https://github.com/Jonasmpi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonasmpi/astro-ai-disclosure.git"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.4.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
