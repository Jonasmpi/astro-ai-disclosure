---
import { resolveBadge, resolveDisclosure } from "@jonasmpi/astro-ai-disclosure";
import type {
  AIDisclosure,
  BadgePosition,
  DisclosurePolicy,
  Language,
} from "@jonasmpi/astro-ai-disclosure/types";
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import manifest from "virtual:ai-image-manifest";
import config from "virtual:astro-ai-disclosure/config";

import DisclosureFrame from "./DisclosureFrame.astro";

type AstroImageProps = ComponentProps<typeof Image>;

/**
 * Inherits the full `<Image>` prop type, so every optimization option —
 * `widths`, `sizes`, `format`, `quality`, `densities` — keeps working. The
 * disclosure props are additive and each one overrides the central config for
 * this image only.
 */
type Props = AstroImageProps & {
  ai?: AIDisclosure;
  policy?: DisclosurePolicy;
  language?: Language;
  badgePosition?: BadgePosition;
};

const { ai, policy, language, badgePosition, class: imageClass, ...imageProps } = Astro.props;

// An inline `ai` prop wins; otherwise the sidecar manifest is consulted,
// matched on the image's own absolute path.
const disclosure = resolveDisclosure(ai, imageProps.src, manifest);

const badge = resolveBadge({ ai: disclosure, policy, language, badgePosition }, config);
---

<DisclosureFrame badge={badge}>
  <Image {...imageProps} class={imageClass} />
</DisclosureFrame>
