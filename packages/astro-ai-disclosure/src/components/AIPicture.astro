---
import {
  describeImage,
  recordDisclosure,
  reportIssue,
  resolveBadge,
  resolveDisclosure,
  validateDisclosure,
} from "@jonasmpi/astro-ai-disclosure";
import type {
  AIDisclosure,
  BadgeIcon,
  BadgeMode,
  BadgePosition,
  DisclosurePolicy,
  Language,
} from "@jonasmpi/astro-ai-disclosure/types";
import { Picture } from "astro:assets";
import type { ComponentProps } from "astro/types";
import manifest from "virtual:ai-image-manifest";
import config from "virtual:astro-ai-disclosure/config";

import DisclosureFrame from "./DisclosureFrame.astro";

type AstroPictureProps = ComponentProps<typeof Picture>;

/**
 * Inherits the full `<Picture>` prop type, so `formats`, `fallbackFormat` and
 * `pictureAttributes` keep working alongside the usual optimization options.
 *
 * Disclosure behaviour is identical to `AIImage` — both resolve the same badge
 * view model and render the same frame.
 */
type Props = AstroPictureProps & {
  ai?: AIDisclosure;
  policy?: DisclosurePolicy;
  language?: Language;
  badgePosition?: BadgePosition;
  badgeMode?: BadgeMode;
  badgeIcon?: BadgeIcon;
};

const {
  ai,
  policy,
  language,
  badgePosition,
  badgeMode,
  badgeIcon,
  class: imageClass,
  ...pictureProps
} = Astro.props;

// An inline `ai` prop wins; otherwise the sidecar manifest is consulted,
// matched on the image's own absolute path.
const disclosure = resolveDisclosure(ai, pictureProps.src, manifest);

// Throws for a rule set to `error`, warns for `warn`. The severities are
// already collapsed for the current command by the integration.
reportIssue(validateDisclosure(disclosure, pictureProps.src, config.validation));

const badge = resolveBadge(
  { ai: disclosure, policy, language, badgePosition, badgeMode, badgeIcon },
  config,
);

// In baked mode the label is composited into the pixels by the image service,
// so the overlay must not also render it. The custom props reach the service
// through <Image>; without this package's image service configured they are
// simply ignored, and nothing is labelled — which the README calls out.
const baked = badge.mode === "baked" && badge.show && disclosure !== undefined;
const frameBadge = baked ? { ...badge, show: false } : badge;

// Feeds the compliance report the integration writes at the end of a build.
recordDisclosure({
  image: describeImage(pictureProps.src),
  ...(disclosure !== undefined && { disclosure }),
  badge: badge.show,
  policy: policy ?? config.policy,
  page: Astro.url?.pathname,
});
---

<DisclosureFrame badge={frameBadge}>
  <Picture
    {...pictureProps}
    class={imageClass}
    aiKind={baked ? disclosure!.kind : undefined}
    aiLabel={baked ? badge.label : undefined}
    aiIcon={baked && badge.icon === "eu" ? "eu" : undefined}
  />
</DisclosureFrame>
